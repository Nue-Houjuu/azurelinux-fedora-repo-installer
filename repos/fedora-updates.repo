[updates-azurelinux-experimental]
name=Fedora @FEDORA_RELEASE@ - Updates (experimental for Azure Linux)
baseurl=https://download.fedoraproject.org/pub/fedora/linux/updates/@FEDORA_RELEASE@/Everything/$basearch/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-@FEDORA_RELEASE@-primary
skip_if_unavailable=False
