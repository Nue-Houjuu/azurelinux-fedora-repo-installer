[fedora-azurelinux-experimental]
name=Fedora @FEDORA_RELEASE@ - Everything (experimental for Azure Linux)
baseurl=https://download.fedoraproject.org/pub/fedora/linux/releases/@FEDORA_RELEASE@/Everything/$basearch/os/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-@FEDORA_RELEASE@-primary
skip_if_unavailable=False
